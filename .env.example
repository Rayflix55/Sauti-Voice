# Sauti environment — copy to .env.local (that file wins over .env).
# All keys are optional: with none set, transcription and structuring both
# degrade to on-device fallbacks so a demo never hard-fails.

# ── LLM: statement structuring (free Google AI Studio tier) ────────────────
# Create a key at https://aistudio.google.com/apikey — no billing account needed.
GEMINI_API_KEY=

# Model used for structuring. The free tier covers Flash / Flash-Lite only;
# Pro models require billing. Swap for e.g. gemini-2.5-flash-lite if you hit
# the free-tier request caps.
GEMINI_MODEL=gemini-2.5-flash

# Optional LLM tuning
# GEMINI_MAX_OUTPUT_TOKENS=1600
# GEMINI_THINKING_BUDGET=0        # tokens of "thinking"; 0 = off (fast, cheap). "auto" = model default
# LLM_TIMEOUT_MS=45000
# LLM_STRICT=1                    # fail /api/structure instead of falling back to the offline parser
# GOOGLE_API_KEY=                 # honoured as an alias if GEMINI_API_KEY is absent

# ── ASR: Sahara (Intron) speech-to-text ────────────────────────────────────
SAHARA_API_KEY=
# INTRON_API_KEY=                 # alias

# ── Benchmark-only (Hugging Face Whisper comparison) ───────────────────────
# HF_API_TOKEN=
